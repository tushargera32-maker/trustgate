# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/trust_gate?schema=public"
# For local quick dev you may use SQLite:
# DATABASE_URL="file:./dev.db"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- Site / Brand ---
NEXT_PUBLIC_SITE_NAME="Trust Gate Overseas"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@trustgate.example"
NEXT_PUBLIC_CONTACT_PHONE="+1 000 000 0000"
NEXT_PUBLIC_WHATSAPP="+10000000000"
NEXT_PUBLIC_OFFICE_ADDRESS="Level 12, Business Bay, Mumbai, India"

# --- Analytics / Tracking (optional) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Email (optional - integration layer only) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Trust Gate Overseas <no-reply@trustgate.example>"

# --- WhatsApp Business (optional - integration layer only) ---
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# --- Payments (optional - integration layer only) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
