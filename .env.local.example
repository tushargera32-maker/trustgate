# Database Configuration
# For PostgreSQL (production)
DATABASE_URL="postgresql://user:password@localhost:5432/trustgate"

# For SQLite (quick local development)
# DATABASE_URL="file:./dev.db"
# Note: Change prisma/schema.prisma provider to "sqlite" when using SQLite

# NextAuth Configuration
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-48"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Email Configuration (for sending emails)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Optional: Payment Integration
# RAZORPAY_KEY_ID="your-key-id"
# RAZORPAY_KEY_SECRET="your-secret"

# Optional: File Storage (S3-compatible)
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_BUCKET="trustgate-documents"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"

# Optional: Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
