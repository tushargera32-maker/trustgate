// Trust Gate Overseas — Prisma schema
// Database: PostgreSQL recommended (SQLite acceptable for local dev).
// Switch the provider via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled endpoint (pgbouncer) for app queries — reuses connections instead
  // of paying a TCP + TLS handshake on every request.
  url       = env("DATABASE_URL")
  // Direct endpoint for migrations: pgbouncer cannot run DDL in transaction
  // pooling mode. Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & Access
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  COUNSELLOR
  CASE_MANAGER
  CONTENT_MANAGER
  FINANCE
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  passwordHash  String?
  image         String?
  role          Role      @default(CLIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 1:1 to a Client record (only when role = CLIENT)
  client        Client?
  staffProfile  StaffProfile?
  sessions      Session[]
  accounts      Account[]
  assignedLeads Lead[]     @relation("AssignedStaff")
  cases         Application[] @relation("CaseOwner")
  auditLogs     AuditLog[]
  notifications Notification[]
  messages      Message[]   @relation("MessageSender")
  blogPosts     BlogPost[]
  updatesAuthored ImmigrationUpdate[]

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  bio       String?  @db.Text
  avatar    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// CRM — Leads
// ─────────────────────────────────────────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  CONSULTATION_COMPLETED
  INTERESTED
  DOCUMENTS_PENDING
  CONVERTED
  NOT_INTERESTED
  LOST
}

enum LeadSource {
  WEBSITE_CONTACT
  ELIGIBILITY_FORM
  BOOKING
  REFERRAL
  WHATSAPP
  MANUAL
  OTHER
}

model Lead {
  id            String     @id @default(cuid())
  fullName      String
  email         String
  phone         String?
  countryOfInterest String?
  visaTypeInterest String?
  source        LeadSource @default(WEBSITE_CONTACT)
  stage         LeadStage  @default(NEW)
  notes         String?    @db.Text
  assignedToId  String?
  assignedTo    User?      @relation("AssignedStaff", fields: [assignedToId], references: [id])
  convertedToClientId String? @unique
  convertedToClient   Client? @relation(fields: [convertedToClientId], references: [id])
  eligibilityResultId String? @unique
  eligibilityResult   EligibilityResult? @relation(fields: [eligibilityResultId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  activities    LeadActivity[]

  @@index([stage])
  @@index([assignedToId])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // note | email | call | meeting | status_change
  body      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ─────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────

model Client {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  email         String
  phone         String?
  nationality   String?
  currentCountry String?
  dateOfBirth   DateTime?
  passportNumber String?
  address       String?  @db.Text
  notes         String?  @db.Text

  applications  Application[]
  appointments  Appointment[]
  payments      Payment[]
  documents     Document[]
  leads         Lead[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Geography & Visas
// ─────────────────────────────────────────────────────────────

model Country {
  id          String   @id @default(cuid())
  code        String   @unique   // ISO alpha-2
  name        String
  region      String?
  flag        String?
  heroImage   String?
  overview    String?  @db.Text
  processing  String?  // human-readable estimate, e.g. "6–8 months"
  govFeeNote  String?  @db.Text
  seoTitle    String?
  seoDescription String? @db.Text
  ogImage     String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visaTypes     VisaType[]
  services      Service[]
  applications  Application[]
  stories       SuccessStory[]
  updates       ImmigrationUpdate[]
  blogPosts     BlogPost[]

  @@index([published, order])
}

model VisaType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  accent      String?
  description String?  @db.Text
  order       Int      @default(0)
  published   Boolean  @default(true)
  countries   Country[]
  services    Service[]
  applications Application[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Services & Applications
// ─────────────────────────────────────────────────────────────

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Service {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDesc       String?  @db.Text
  overview        String?  @db.Text
  whoIsItFor      String?  @db.Text
  eligibility     String?  @db.Text
  documents       String?  @db.Text
  process         String?  @db.Text
  considerations  String?  @db.Text
  faq             Json?
  featuredImage   String?
  status          ServiceStatus @default(PUBLISHED)
  order           Int      @default(0)
  seoTitle        String?
  seoDescription  String?  @db.Text
  seoOgImage      String?
  countries       Country[]
  visaTypes       VisaType[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, order])
}

enum ApplicationStatus {
  CONSULTATION_COMPLETED
  DOCUMENTS_REQUESTED
  DOCUMENTS_RECEIVED
  DOCUMENTS_VERIFIED
  APPLICATION_PREPARED
  APPLICATION_SUBMITTED
  BIOMETRICS
  ADDITIONAL_INFO_REQUESTED
  DECISION_PENDING
  DECISION_RECEIVED
}

model Application {
  id              String   @id @default(cuid())
  reference       String   @unique
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  countryId       String
  country         Country  @relation(fields: [countryId], references: [id])
  visaTypeId      String?
  visaType        VisaType? @relation(fields: [visaTypeId], references: [id])
  serviceId       String?
  caseOwnerId     String?
  caseOwner       User?    @relation("CaseOwner", fields: [caseOwnerId], references: [id])
  status          ApplicationStatus @default(CONSULTATION_COMPLETED)
  progressPct     Int      @default(10)
  submittedAt     DateTime?
  decisionAt      DateTime?
  decisionOutcome String?
  internalNotes   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timelineEntries ApplicationTimeline[]
  documents       Document[]
  payments        Payment[]
  messages        Message[]
  appointments    Appointment[]

  @@index([clientId])
  @@index([countryId])
  @@index([status])
}

model ApplicationTimeline {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?  @db.Text
  occurredAt    DateTime @default(now())
  visibleToClient Boolean @default(true)

  @@index([applicationId, occurredAt])
}

// ─────────────────────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────────────────────

enum DocumentStatus {
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REPLACEMENT_REQUIRED
}

model DocumentRequirement {
  id            String   @id @default(cuid())
  countryId     String?
  visaTypeId    String?
  title         String
  description   String?  @db.Text
  required      Boolean  @default(true)
  order         Int      @default(0)

  @@index([countryId, visaTypeId])
}

model Document {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  title         String
  status        DocumentStatus @default(REQUESTED)
  storageKey    String?  // object storage path, never public
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  uploadedAt    DateTime?
  reviewedAt    DateTime?
  reviewerNote  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       DocumentReview[]

  @@index([clientId])
  @@index([applicationId])
  @@index([status])
}

model DocumentReview {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId  String?
  decision    DocumentStatus
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────
// Appointments & Messaging
// ─────────────────────────────────────────────────────────────

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id            String   @id @default(cuid())
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  staffId       String?
  title         String
  type          String   // consultation | call | meeting
  scheduledAt   DateTime
  durationMin   Int      @default(30)
  status        AppointmentStatus @default(REQUESTED)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scheduledAt])
  @@index([staffId])
}

model Message {
  id            String   @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  senderId      String
  sender        User     @relation("MessageSender", fields: [senderId], references: [id])
  body          String   @db.Text
  isInternal    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([applicationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Payments & Invoices
// ─────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  status        PaymentStatus @default(PENDING)
  description   String?
  invoiceNo     String?  @unique
  provider      String?  // razorpay | manual | other
  providerRef   String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  clientId    String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  lineItems   Json
  status      PaymentStatus @default(PENDING)
  pdfStorageKey String?
}

// ─────────────────────────────────────────────────────────────
// Reviews & Stories
// ─────────────────────────────────────────────────────────────

model SuccessStory {
  id          String   @id @default(cuid())
  clientName  String
  clientImage String?
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id])
  visaType    String?
  summary     String?  @db.Text
  body        String?  @db.Text
  approvedAt  DateTime?
  rating      Int?     // 1-5
  externalUrl String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  body      String   @db.Text
  rating    Int      @default(5)
  source    String?  // google | trustpilot | internal
  url       String?
  createdAt DateTime @default(now())
  approved  Boolean  @default(true)
}

// ─────────────────────────────────────────────────────────────
// Blog & Immigration Updates
// ─────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  posts     BlogPost[]
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  posts     BlogPost[] @relation("PostTags")
}

model BlogPost {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?  @db.Text
  body           String   @db.Text
  authorId       String?
  author         User?    @relation(fields: [authorId], references: [id])
  countryId      String?
  country        Country? @relation(fields: [countryId], references: [id])
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  tags           Tag[]    @relation("PostTags")
  featuredImage  String?
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt    DateTime?
  scheduledAt    DateTime?
  seoTitle       String?
  seoDescription String?  @db.Text
  seoOgImage     String?
  canonicalUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([countryId])
}

model ImmigrationUpdate {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String?  @db.Text
  body            String   @db.Text
  effectiveDate   DateTime?
  publishedAt     DateTime?
  lastVerifiedAt  DateTime?
  sourceName      String?
  sourceUrl       String?
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id])
  countryId       String?
  country         Country? @relation(fields: [countryId], references: [id])
  visaType        String?
  featuredImage   String?
  status          String   @default("DRAFT")
  featured        Boolean  @default(false)
  seoTitle        String?
  seoDescription  String?  @db.Text
  seoOgImage      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([countryId])
}

// ─────────────────────────────────────────────────────────────
// Eligibility Engine
// ─────────────────────────────────────────────────────────────

model EligibilityQuestion {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  helpText    String?  @db.Text
  type        String   // text | number | select | radio | checkbox
  options     Json?
  order       Int      @default(0)
  required    Boolean  @default(true)
  active      Boolean  @default(true)
}

model EligibilityRule {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  // JSONLogic-style predicate evaluated against collected answers
  predicate   Json
  // Result label applied when predicate matches. Must be one of the codes in
  // OUTCOME_CODES (src/lib/eligibility.ts), which is the single source of truth.
  outcome     String
  priority    Int      @default(0)
  active      Boolean  @default(true)
}

model EligibilityResult {
  id          String   @id @default(cuid())
  fullName    String?
  email       String
  phone       String?
  answers     Json
  // ROUTE_MATCHED | ROUTE_MATCHED_WITH_CARE | ROUTE_UNPUBLISHED | SCOPE_REFERRAL
  // Kept as String rather than an enum so the triage engine can gain outcomes
  // without a migration. Source of truth: OUTCOME_CODES in src/lib/eligibility.ts.
  outcome     String
  // The engine's reasoning trail, e.g. ["refusal:yes", "outcome:route_matched_with_care"].
  matchedRules Json?
  lead        Lead?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// ─────────────────────────────────────────────────────────────
// Audit Log
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Site Settings
// ─────────────────────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}